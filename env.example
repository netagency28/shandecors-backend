# Database
DATABASE_URL="postgresql://username:password@localhost:5432/shandecor"

# Supabase
SUPABASE_URL="your-supabase-url"
SUPABASE_KEY="your-supabase-anon-key"
# Required for signup confirmation & password reset emails (via Resend). Find in Supabase → Settings → API → service_role.
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
SUPABASE_JWT_SECRET="your-supabase-jwt-secret"

# Cashfree Payment
PAYMENT_GATEWAY="cashfree"
ENABLE_CASHFREE="true"
CASHFREE_CLIENT_ID="your-cashfree-client-id"
CASHFREE_CLIENT_SECRET="your-cashfree-client-secret"
CASHFREE_ENVIRONMENT="sandbox"
CASHFREE_API_VERSION="2023-08-01"
# Required in production to verify Cashfree webhook signatures
CASHFREE_WEBHOOK_SECRET=""

# Instamojo Payment
ENABLE_INSTAMOJO="false"
INSTAMOJO_CLIENT_ID="your-instamojo-client-id"
INSTAMOJO_CLIENT_SECRET="your-instamojo-client-secret"
INSTAMOJO_ENVIRONMENT="test"
# Optional overrides if your account/docs use different endpoints
INSTAMOJO_TOKEN_URL=""
INSTAMOJO_API_BASE_URL=""

# Resend Email
RESEND_API_KEY="your-resend-api-key"
SENDER_EMAIL="your-email@example.com"

# Admin notifications (order alerts + technical issues)
# Recipients = DB users with ADMIN role + extra emails below (deduped).
# Set ADMIN_NOTIFY_DB_ADMINS=false to use only the env list (no DB lookup).
ADMIN_NOTIFY_DB_ADMINS=true
# Comma-separated extra recipients (ops/owner emails not in the admin panel)
ADMIN_NOTIFICATION_EMAIL="sanjayvihaan111@gmail.com"
# Comma-separated emails to NEVER notify (still keeps admin panel access if role=ADMIN)
ADMIN_NOTIFICATION_EXCLUDE=""
# Telegram: create a bot via @BotFather, then get chat id from @userinfobot or a group
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# Checkout payment token signing (required for payment create/verify)
CHECKOUT_TOKEN_SECRET="generate-a-long-random-secret"

# Database seeding in production (optional — requires admin auth + this header)
SEED_SECRET=""

# Supabase Storage
SUPABASE_STORAGE_URL="your-supabase-storage-url"
SUPABASE_STORAGE_BUCKET="your-storage-bucket-name"

# Server
PORT=8000
NODE_ENV=development
BACKEND_URL="http://localhost:8000"
# Production: https://api.shandecors.store
FRONTEND_URL="http://localhost:3000"
# Optional: comma-separated allowlist for local + production frontend URLs.
# Avoid trailing slashes, but the server now normalizes them if present.
CORS_ORIGINS="http://localhost:3000,https://shandecors.store,https://www.shandecors.store,https://shandecors.vercel.app"

# AI Services
ANTHROPIC_API_KEY="your-anthropic-key"
OPENAI_API_KEY="your-openai-key"
GOOGLE_AI_API_KEY="your-google-ai-key"
